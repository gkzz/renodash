{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // 共通の Renovate 運用ポリシーは gkzz/renovate-config の default preset に集約する。
  extends: ["github>gkzz/renovate-config"],

  // 現在は外部モジュールへの依存がないため、Go モジュール用のルールは無効にしておく。
  // 今後 go.mod に外部依存を追加した際は、以下のルールを packageRules に追加する。
  // packageRules: [
  //   {
  //     description: "Go モジュールの依存関係を更新する",
  //     matchManagers: ["gomod"],
  //     matchDatasources: ["go"],
  //
  //     // 更新後に go mod tidy を実行し、go.mod と go.sum を整理する。
  //     postUpdateOptions: ["gomodTidy"],
  //   },
  //   {
  //     description: "Go モジュールの間接依存も更新対象に含める",
  //     matchManagers: ["gomod"],
  //     matchDepTypes: ["indirect"],
  //
  //     // Renovate は通常、間接依存を個別の更新対象にしないため明示的に有効化する。
  //     enabled: true,
  //   },
  // ],

  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [
        "/^\\.config/mise/config\\.toml$/",
        "/^\\.github/actions/setup-mise/action\\.yml$/",
      ],
      matchStrings: [
        'min_version = "(?<currentValue>[^"\\s]+)"',
        'MISE_VERSION: "(?<currentValue>[^"\\s]+)"',
      ],
      depNameTemplate: "mise",
      packageNameTemplate: "jdx/mise",
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver",
      extractVersionTemplate: "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      // 各環境のチェックサムを GitHub Release の添付ファイルから更新する。
      customType: "regex",
      managerFilePatterns: ["/^\\.github/actions/setup-mise/action\\.yml$/"],
      matchStrings: [
        '# mise (?<currentValue>v[0-9.]+) (?<depName>[^\\s]+)\\n[ \\t]+MISE_SHA256_[A-Z0-9_]+: "(?<currentDigest>[a-f0-9]{64})"',
      ],
      packageNameTemplate: "jdx/mise",
      datasourceTemplate: "github-release-attachments",
      versioningTemplate: "semver",
    },
  ],

  packageRules: [
    {
      // mise 本体は gkzz/dotfiles で先に更新し、こちらはその後に追従する。
      // 更新順序は制御できないため、マージ前に dotfiles 側の更新を確認する。
      matchManagers: ["custom.regex"],
      matchPackageNames: ["jdx/mise"],
      groupName: "mise CLI",
      groupSlug: "mise-cli",
      // 年をまたぐ major 更新も、全環境のチェックサムと同じ PR にまとめる。
      separateMajorMinor: false,
    },
    {
      // fixture 内のバージョンはスナップショットとして保持する。
      description: "testdata 配下の依存関係を更新対象から除外する",
      matchFileNames: ["**/testdata/**"],
      enabled: false,
    },
  ],

  // go.mod の go ディレクティブは Go の最低要求バージョンを表す。
  // 引き上げは必要に応じて手動で行う。
  //
  // 開発・CI で実際に使用する Go のバージョンは
  // .config/mise/config.toml で管理する。
}
