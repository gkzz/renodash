{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Keep shared Renovate policies in the default preset of gkzz/renovate-config.
  extends: [
    "github>gkzz/renovate-config",
    "github>gkzz/renovate-config:actions-lock",
    "github>gkzz/renovate-config:node-preset.json5",
  ],

  // Leave Go module rules inactive while there are no external module dependencies.
  // Add the following rules to packageRules when external dependencies are added to go.mod.
  // packageRules: [
  //   {
  //     description: "Update Go module dependencies",
  //     matchManagers: ["gomod"],
  //     matchDatasources: ["go"],
  //
  //     // Run go mod tidy after updates to tidy go.mod and go.sum.
  //     postUpdateOptions: ["gomodTidy"],
  //   },
  //   {
  //     description: "Include indirect Go module dependencies in updates",
  //     matchManagers: ["gomod"],
  //     matchDepTypes: ["indirect"],
  //
  //     // Explicitly enable indirect dependency updates, which Renovate normally skips.
  //     enabled: true,
  //   },
  // ],

  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [
        "/^\\.config/mise/config\\.toml$/",
        "/^\\.github/actions/setup-mise/action\\.yml$/",
      ],
      matchStrings: [
        'min_version = "(?<currentValue>[^"\\s]+)"',
        'MISE_VERSION: "(?<currentValue>[^"\\s]+)"',
      ],
      depNameTemplate: "mise",
      packageNameTemplate: "jdx/mise",
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver",
      extractVersionTemplate: "^v(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      // Update checksums for each environment from GitHub release attachments.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/actions/setup-mise/action\\.yml$/"],
      matchStrings: [
        '# mise (?<currentValue>v[0-9.]+) (?<depName>[^\\s]+)\\n[ \\t]+MISE_SHA256_[A-Z0-9_]+: "(?<currentDigest>[a-f0-9]{64})"',
      ],
      packageNameTemplate: "jdx/mise",
      datasourceTemplate: "github-release-attachments",
      versioningTemplate: "semver",
    },
  ],

  // pnpm itself is pinned only in .config/mise/config.toml and mise.lock, so its updates
  // stay in the inherited mise toolchain group. Keep npm enabled for devDependencies.
  packageRules: [
    {
      // Update mise in gkzz/dotfiles first, then update it here.
      // Renovate cannot enforce this order, so check the dotfiles update before merging.
      matchManagers: ["custom.regex"],
      matchPackageNames: ["jdx/mise"],
      groupName: "mise CLI",
      groupSlug: "mise-cli",
      // Group major updates across calendar years with checksums for all environments in one PR.
      separateMajorMinor: false,
    },
    {
      // Preserve fixture versions as snapshots.
      description: "Exclude dependencies under testdata from updates",
      matchFileNames: ["**/testdata/**"],
      enabled: false,
    },
  ],

  // The go directive in go.mod specifies the oldest supported Go version.
  // Raise it manually as needed.
  //
  // Manage the Go version used for development and CI in .config/mise/config.toml.
}
